PORT=3000
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5433/transaction_db
AUTO_MIGRATE=true

# Uploads
MAX_FILE_SIZE_BYTES=524288000
TEMP_UPLOAD_DIR=./uploads

# Processing concurrency
# Tune per machine: CPU-bound scoring stops scaling past the fast physical cores.
WORKER_CONCURRENCY=4
BATCH_SIZE=1000
MAX_ACTIVE_IMPORTS=2
MAX_PENDING_IMPORTS=20

# Batch-write retry
RETRY_MAX_ATTEMPTS=4
RETRY_INITIAL_DELAY_MS=100
RETRY_MAX_DELAY_MS=3000

# Observability
LOG_LEVEL=info

# Benchmark script target
API_BASE=http://localhost:3000
